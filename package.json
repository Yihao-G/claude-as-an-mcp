{
  "name": "claude-as-an-mcp",
  "version": "0.1.0",
  "description": "A local MCP server that lets OpenCode hand tasks to Claude Code through the Claude Agent SDK.",
  "private": true,
  "type": "module",
  "bin": {
    "claude-as-an-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && node dist/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "$vite"
  }
}
